{
  "name": "@tubeagentkit/getyoutubetranscript",
  "version": "0.2.1",
  "description": "YouTube transcript API for Node.js and TypeScript: get YouTube video transcripts, captions and subtitles with timestamps, search YouTube, and list channel and playlist videos. No proxies or headless browser.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --exclude '**/live.integration.test.ts'",
    "test:live": "vitest run test/live.integration.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "youtube",
    "youtube-transcript",
    "youtube-transcripts",
    "youtube-transcript-api",
    "transcript",
    "transcripts",
    "captions",
    "subtitles",
    "youtube-captions",
    "youtube-subtitles",
    "timestamps",
    "youtube-api",
    "youtube-search",
    "llm",
    "ai",
    "rag",
    "typescript",
    "sdk",
    "api-client"
  ],
  "author": "tubeagentkit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tubeagentkit/youtube-transcript-api-node.git"
  },
  "homepage": "https://getyoutubetranscript.com",
  "bugs": {
    "url": "https://github.com/tubeagentkit/youtube-transcript-api-node/issues"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^5.0.2"
  }
}
